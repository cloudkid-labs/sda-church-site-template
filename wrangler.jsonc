{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "replace-with-church-slug",
  "main": "src/worker/index.js",
  "compatibility_date": "2025-03-10",
  "workers_dev": false,
  "vars": {
    "CF_ACCESS_TEAM_DOMAIN": "",
    "CF_ACCESS_AUD": "",
    "NEWSLETTER_LIST_ID": "0",
    "TURNSTILE_HOSTNAMES": ""
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "r2_buckets": [
    {
      "binding": "CMS",
      "bucket_name": "replace-with-church-slug-cms"
    }
  ],
  "ratelimits": [
    {
      "name": "NEWSLETTER_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ]
}
